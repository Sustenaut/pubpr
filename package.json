{
  "name": "pubpr",
  "version": "0.1.1",
  "description": "Propose changes to a GitHub repository as one commit and a pull request, from a browser or Node.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./lib/pubpr.js",
    "./fake": "./lib/fake.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "c8 --reporter=lcov --reporter=text-summary --reports-dir=coverage --include='lib/**' cucumber-js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sustenaut/pubpr.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@sustenaut/pubtest": "github:Sustenaut/pubtest#v0.2.1",
    "c8": "12.0.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
